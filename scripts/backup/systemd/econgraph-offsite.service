[Unit]
Description=econ-graph off-site copy of the verified dumps (restic)
Documentation=file://%h/src/econ-graph/docs/deployment/BACKUPS.md
# Only meaningful once ~/.config/econgraph/restic.env exists. Without it the
# unit is skipped, not failed; check-freshness.sh reports the off-site copy as
# not configured (NOTCONF), or fails with OFFSITE_REQUIRED=1.
ConditionPathExists=%h/.config/econgraph/restic.env
OnFailure=econgraph-notify@%N.service
# Restart=on-failure below retries every 5 minutes. Four starts within 3 hours
# is the limit: the fifth leaves the unit failed, so OnFailure= reports a copy
# that keeps failing instead of retrying silently.
StartLimitIntervalSec=3h
StartLimitBurst=4

[Service]
Type=oneshot
# A user unit cannot wait for the system's network-online.target, and the
# timer may fire right after boot or login: retry a failed run (restic
# backup only adds, so a retry is safe).
Restart=on-failure
RestartSec=5min
ExecStart=%h/.local/lib/econgraph-backup/offsite-restic.sh backup
Nice=10
IOSchedulingClass=idle
