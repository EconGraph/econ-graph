[Unit]
Description=econ-graph nightly pg_dump of econ_graph and keycloak (verified)
Documentation=file://%h/src/econ-graph/docs/deployment/BACKUPS.md
OnFailure=econgraph-notify@%N.service

[Service]
Type=oneshot
# The kind cluster runs on the rootful daemon at /var/run/docker.sock, which
# The operator reaches through the docker group. lib.sh sets DOCKER_HOST to it
# (override with ECONGRAPH_DOCKER_HOST in ~/.config/econgraph/backup.env).
# No After=docker.service: a user unit can't order itself after a system one.
ExecStart=%h/.local/lib/econgraph-backup/dump-databases.sh
# After a success: the next failure is reported at once (notify.sh ok).
ExecStartPost=-%h/.local/lib/econgraph-backup/notify.sh ok %N
Nice=10
IOSchedulingClass=idle
