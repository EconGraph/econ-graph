    {
      "kind": "StatefulSet",
      "last_applied": {
        "apiVersion": "apps/v1",
        "kind": "StatefulSet",
        "metadata": {
          "annotations": {},
          "labels": {
            "app": "keycloak-postgres",
            "version": "18"
          },
          "name": "keycloak-postgres",
          "namespace": "econ-graph"
        },
        "spec": {
          "replicas": 1,
          "selector": {
            "matchLabels": {
              "app": "keycloak-postgres"
            }
          },
          "serviceName": "keycloak-postgres-service",
          "template": {
            "metadata": {
              "labels": {
                "app": "keycloak-postgres",
                "version": "18"
              }
            },
            "spec": {
              "containers": [
                {
                  "env": [
                    {
                      "name": "POSTGRES_DB",
                      "value": "keycloak"
                    },
                    {
                      "name": "POSTGRES_USER",
                      "value": "keycloak"
                    },
                    {
                      "name": "POSTGRES_PASSWORD",
                      "valueFrom": {
                        "secretKeyRef": {
                          "key": "db-password",
                          "name": "econ-graph-keycloak"
                        }
                      }
                    }
                  ],
                  "image": "postgres:18",
                  "livenessProbe": {
                    "exec": {
                      "command": [
                        "pg_isready",
                        "-U",
                        "keycloak",
                        "-d",
                        "keycloak"
                      ]
                    },
                    "failureThreshold": 3,
                    "initialDelaySeconds": 30,
                    "periodSeconds": 10,
                    "timeoutSeconds": 5
                  },
                  "name": "postgres",
                  "ports": [
                    {
                      "containerPort": 5432,
                      "name": "postgres"
                    }
                  ],
                  "readinessProbe": {
                    "exec": {
                      "command": [
                        "pg_isready",
                        "-U",
                        "keycloak",
                        "-d",
                        "keycloak"
                      ]
                    },
                    "failureThreshold": 3,
                    "initialDelaySeconds": 5,
                    "periodSeconds": 5,
                    "timeoutSeconds": 3
                  },
                  "resources": {
                    "limits": {
                      "cpu": "500m",
                      "memory": "512Mi"
                    },
                    "requests": {
                      "cpu": "100m",
                      "memory": "256Mi"
                    }
                  },
                  "securityContext": {
                    "allowPrivilegeEscalation": false,
                    "capabilities": {
                      "drop": [
                        "ALL"
                      ]
                    },
                    "runAsNonRoot": true,
                    "runAsUser": 999,
                    "seccompProfile": {
                      "type": "RuntimeDefault"
                    }
                  },
                  "volumeMounts": [
                    {
                      "mountPath": "/var/lib/postgresql",
                      "name": "keycloak-postgres-data"
                    }
                  ]
                }
              ],
              "initContainers": [
                {
                  "command": [
                    "sh",
                    "-ec",
                    "root=\"$1\"; pgdata=\"$2\"\n# The host directory starts out owned by jmalicki (uid 1000). Postgres runs\n# as 999 and has to create PGDATA inside it, so hand the volume root over.\nchown 999:999 \"$root\"\nchmod 0700 \"$root\"\n# A data directory restored by a copy that didn't keep ownership (anything\n# but 999:999) would stop Postgres starting; fix it once.\nif [ -e \"$pgdata\" ] && [ \"$(stat -c %u:%g \"$pgdata\")\" != \"999:999\" ]; then\n  echo \"fixing ownership of $pgdata\"\n  chown -R 999:999 \"$pgdata\"\nfi\nstat -c '%n %u:%g %a' \"$root\"\n",
                    "init-data-dir",
                    "/var/lib/postgresql",
                    "/var/lib/postgresql/18/docker"
                  ],
                  "image": "postgres:18",
                  "name": "init-data-dir",
                  "securityContext": {
                    "allowPrivilegeEscalation": false,
                    "capabilities": {
                      "add": [
                        "CHOWN",
                        "FOWNER",
                        "DAC_READ_SEARCH"
                      ],
                      "drop": [
                        "ALL"
                      ]
                    },
                    "readOnlyRootFilesystem": true,
                    "runAsNonRoot": false,
                    "runAsUser": 0,
                    "seccompProfile": {
                      "type": "RuntimeDefault"
                    }
                  },
                  "volumeMounts": [
                    {
                      "mountPath": "/var/lib/postgresql",
                      "name": "keycloak-postgres-data"
                    }
                  ]
                }
              ],
              "nodeSelector": {
                "econgraph.io/host-storage": "true"
              },
              "securityContext": {
                "fsGroup": 999
              }
            }
          },
          "volumeClaimTemplates": [
            {
              "metadata": {
                "name": "keycloak-postgres-data"
              },
              "spec": {
                "accessModes": [
                  "ReadWriteOnce"
                ],
                "resources": {
                  "requests": {
                    "storage": "5Gi"
                  }
                },
                "storageClassName": "econgraph-host",
                "volumeName": "econgraph-app-prod-keycloak-pg"
              }
            }
          ]
        }
      },
      "live": {
        "podManagementPolicy": "OrderedReady",
        "selector": {
          "matchLabels": {
            "app": "keycloak-postgres"
          }
        },
        "serviceName": "keycloak-postgres-service",
        "volumeClaimTemplates": [
          {
            "name": "keycloak-postgres-data",
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "resources": {
                "requests": {
                  "storage": "5Gi"
                }
              },
              "storageClassName": "econgraph-host",
              "volumeMode": "Filesystem",
              "volumeName": "econgraph-app-prod-keycloak-pg"
            }
          }
        ]
      },
      "name": "keycloak-postgres"
    },
