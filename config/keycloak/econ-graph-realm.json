{
  "realm": "econ-graph",
  "displayName": "EconGraph",
  "enabled": true,
  "sslRequired": "${KC_REALM_SSL_REQUIRED:external}",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "default-roles-econ-graph",
        "description": "Granted to every account: the user composite plus Keycloak's defaults",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "user"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      },
      {
        "name": "offline_access",
        "description": "Keycloak default: offline access"
      },
      {
        "name": "uma_authorization",
        "description": "Keycloak default: UMA authorization"
      },
      {
        "name": "user",
        "description": "Signed-in user: the fine-grained roles every account holds",
        "composite": true,
        "composites": {
          "client": {
            "econ-graph-api": [
              "annotation:create",
              "annotation:comment",
              "chart:share",
              "api:mcp",
              "catalog.sec:read"
            ]
          },
          "realm": [
            "catalog-public"
          ]
        }
      },
      {
        "name": "support",
        "description": "Support staff: user plus read-only user, session and system views",
        "composite": true,
        "composites": {
          "realm": [
            "user"
          ],
          "client": {
            "econ-graph-api": [
              "admin.users:read",
              "admin.sessions:read",
              "admin.system:read"
            ]
          }
        }
      },
      {
        "name": "admin",
        "description": "Senior staff: support plus every other staff role",
        "composite": true,
        "composites": {
          "realm": [
            "support"
          ],
          "client": {
            "econ-graph-api": [
              "admin.users:create",
              "admin.users:update",
              "admin.users:delete",
              "admin.users:suspend",
              "admin.sessions:revoke",
              "admin.crawlers:manage",
              "admin.security:read",
              "admin.audit:read"
            ]
          }
        }
      },
      {
        "name": "super_admin",
        "description": "Top staff level: everything in admin, nothing extra yet",
        "composite": true,
        "composites": {
          "realm": [
            "admin"
          ]
        }
      },
      {
        "name": "catalog-public",
        "description": "Default catalog reads for users and the anonymous reader; remove a grant here to withdraw default public access",
        "composite": true,
        "composites": {
          "client": {
            "econ-graph-api": [
              "catalog.fred:read",
              "catalog.bls:read",
              "catalog.census:read",
              "catalog.world_bank:read",
              "catalog.bea:read",
              "catalog.imf:read",
              "catalog.fhfa:read",
              "catalog.ecb:read",
              "catalog.oecd:read",
              "catalog.boe:read",
              "catalog.wto:read",
              "catalog.boj:read",
              "catalog.rba:read",
              "catalog.boc:read",
              "catalog.snb:read",
              "catalog.unstats:read",
              "catalog.ilo:read"
            ]
          }
        }
      }
    ],
    "client": {
      "econ-graph-api": [
        {
          "name": "annotation:create",
          "description": "Create an annotation on a series"
        },
        {
          "name": "annotation:comment",
          "description": "Comment on an annotation the caller can see"
        },
        {
          "name": "chart:share",
          "description": "Share a chart the caller owns with another user"
        },
        {
          "name": "api:mcp",
          "description": "Call the MCP endpoint (/mcp)"
        },
        {
          "name": "admin.users:read",
          "description": "List and read any user's account"
        },
        {
          "name": "admin.users:create",
          "description": "Create user accounts"
        },
        {
          "name": "admin.users:update",
          "description": "Update any user's account"
        },
        {
          "name": "admin.users:delete",
          "description": "Delete user accounts"
        },
        {
          "name": "admin.users:suspend",
          "description": "Suspend and reactivate user accounts"
        },
        {
          "name": "admin.sessions:read",
          "description": "List user sessions"
        },
        {
          "name": "admin.sessions:revoke",
          "description": "End a user's sessions (force logout)"
        },
        {
          "name": "admin.crawlers:manage",
          "description": "Trigger and manage crawls"
        },
        {
          "name": "admin.system:read",
          "description": "Read system health"
        },
        {
          "name": "admin.security:read",
          "description": "Read security events"
        },
        {
          "name": "admin.audit:read",
          "description": "Read the audit log"
        },
        {
          "name": "catalog.fred:read",
          "description": "Read the Federal Reserve Economic Data (FRED) catalog"
        },
        {
          "name": "catalog.bls:read",
          "description": "Read the Bureau of Labor Statistics (BLS) catalog"
        },
        {
          "name": "catalog.census:read",
          "description": "Read the U.S. Census Bureau catalog"
        },
        {
          "name": "catalog.world_bank:read",
          "description": "Read the World Bank Open Data catalog"
        },
        {
          "name": "catalog.bea:read",
          "description": "Read the Bureau of Economic Analysis (BEA) catalog"
        },
        {
          "name": "catalog.imf:read",
          "description": "Read the International Monetary Fund (IMF) catalog"
        },
        {
          "name": "catalog.fhfa:read",
          "description": "Read the Federal Housing Finance Agency (FHFA) catalog"
        },
        {
          "name": "catalog.ecb:read",
          "description": "Read the European Central Bank (ECB) catalog"
        },
        {
          "name": "catalog.oecd:read",
          "description": "Read the OECD (Organisation for Economic Co-operation and Development) catalog"
        },
        {
          "name": "catalog.boe:read",
          "description": "Read the Bank of England (BoE) catalog"
        },
        {
          "name": "catalog.wto:read",
          "description": "Read the World Trade Organization (WTO) catalog"
        },
        {
          "name": "catalog.boj:read",
          "description": "Read the Bank of Japan (BoJ) catalog"
        },
        {
          "name": "catalog.rba:read",
          "description": "Read the Reserve Bank of Australia (RBA) catalog"
        },
        {
          "name": "catalog.boc:read",
          "description": "Read the Bank of Canada (BoC) catalog"
        },
        {
          "name": "catalog.snb:read",
          "description": "Read the Swiss National Bank (SNB) catalog"
        },
        {
          "name": "catalog.unstats:read",
          "description": "Read the UN Statistics Division catalog"
        },
        {
          "name": "catalog.ilo:read",
          "description": "Read the International Labour Organization (ILO) catalog"
        },
        {
          "name": "catalog.sec:read",
          "description": "Read structured SEC company research"
        }
      ]
    }
  },
  "defaultRole": {
    "name": "default-roles-econ-graph",
    "composite": true,
    "clientRole": false
  },
  "clients": [
    {
      "clientId": "econ-graph-web",
      "name": "EconGraph web app",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": "${KC_WEB_DIRECT_GRANTS:false}",
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${KC_WEB_BASE_URL}",
      "baseUrl": "/",
      "redirectUris": [
        "${KC_WEB_BASE_URL}/auth/callback",
        "${KC_WEB_BASE_URL}/silent-callback.html",
        "${KC_WEB_E2E_BASE_URL}/auth/callback",
        "${KC_WEB_E2E_BASE_URL}/silent-callback.html"
      ],
      "webOrigins": [
        "${KC_WEB_BASE_URL}",
        "${KC_WEB_E2E_BASE_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${KC_WEB_BASE_URL}/##${KC_WEB_E2E_BASE_URL}/"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "basic",
        "profile",
        "email",
        "roles"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "econ-graph-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "econ-graph-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "econ-graph-api roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "econ-graph-api",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "econ-graph-api",
      "name": "EconGraph API",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "econgraph-anonymous",
      "name": "Anonymous catalog grant source (server only)",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "secret": "${KC_ANONYMOUS_CLIENT_SECRET:anonymous-dev-only}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic"
      ],
      "protocolMappers": [
        {
          "name": "econ-graph-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "econ-graph-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "econ-graph-api roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "econ-graph-api",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": "${KC_GOOGLE_ENABLED:false}",
      "trustEmail": true,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${KC_GOOGLE_CLIENT_ID:unset}",
        "clientSecret": "${KC_GOOGLE_CLIENT_SECRET:unset}",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "facebook",
      "displayName": "Facebook",
      "providerId": "facebook",
      "enabled": "${KC_FACEBOOK_ENABLED:false}",
      "trustEmail": false,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${KC_FACEBOOK_CLIENT_ID:unset}",
        "clientSecret": "${KC_FACEBOOK_CLIENT_SECRET:unset}",
        "defaultScope": "email,public_profile",
        "syncMode": "IMPORT"
      }
    }
  ],
  "clientScopeMappings": {
    "econ-graph-api": [
      {
        "client": "econgraph-anonymous",
        "roles": [
          "catalog.fred:read",
          "catalog.bls:read",
          "catalog.census:read",
          "catalog.world_bank:read",
          "catalog.bea:read",
          "catalog.imf:read",
          "catalog.fhfa:read",
          "catalog.ecb:read",
          "catalog.oecd:read",
          "catalog.boe:read",
          "catalog.wto:read",
          "catalog.boj:read",
          "catalog.rba:read",
          "catalog.boc:read",
          "catalog.snb:read",
          "catalog.unstats:read",
          "catalog.ilo:read"
        ]
      }
    ]
  },
  "users": [
    {
      "username": "service-account-econgraph-anonymous",
      "enabled": true,
      "serviceAccountClientId": "econgraph-anonymous",
      "realmRoles": [
        "catalog-public"
      ]
    }
  ]
}
