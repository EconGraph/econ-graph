# Lightweight Test Runner Container
# This only contains test dependencies and connects to external services
# The tag matches the @playwright/test version resolved in
# frontend/package-lock.json, so the browsers bundled in /ms-playwright are the
# ones the tests expect. Keep Ubuntu 24.04 and replace its bundled Node.js runtime.
FROM node:26-bookworm AS node-runtime

FROM mcr.microsoft.com/playwright:v1.63.0-noble

COPY --from=node-runtime /usr/local/ /usr/local/
RUN node --version && npm --version

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy package files first for better layer caching
COPY frontend/package*.json ./
# Local API adapter is a locked dependency and must precede npm ci.
COPY frontend/compat ./compat
COPY frontend/playwright.config.ts ./
COPY frontend/playwright.mobile.config.ts ./

# Install ALL dependencies (including dev dependencies for tests)
RUN npm ci

# Copy test files and configurations
COPY frontend/tests/ ./tests/
COPY ci/configs/ ./ci/configs/

# Install Playwright browsers using project's version
RUN npx playwright install --with-deps

# Create test results directory
RUN mkdir -p /app/test-results

# Set environment variables
ENV NODE_ENV=test
ENV CI=true
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Default command
CMD ["npm", "run", "test:e2e"]
