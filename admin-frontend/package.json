{
  "name": "econ-graph-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "homepage": "/admin",
  "description": "Administrative interface for EconGraph platform - INTERNAL USE ONLY",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "prettier:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prettier:fix": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "e2e": "playwright test",
    "e2e:smoke": "npm run build && playwright test --config=playwright.smoke.config.ts",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@apollo/client": "^4.3.1",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@types/lodash": "4.17.25",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "axios": "^1.20.0",
    "chart.js": "4.5.1",
    "chartjs-adapter-date-fns": "3.0.0",
    "date-fns": "3.6.0",
    "graphql": "^16.14.2",
    "lodash": "4.18.1",
    "react": "19.3.1",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "rxjs": "^7.8.2",
    "web-vitals": "3.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jest": "30.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "cookie": "^2.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.5",
    "whatwg-fetch": "^3.6.20"
  },
  "overrides": {
    "nth-check": "^2.1.1",
    "postcss": "^8.4.31",
    "@types/d3-dispatch": "3.0.4",
    "source-map-js": "^1.2.2",
    "seroval": "^1.6.3"
  },
  "resolutions": {
    "@types/d3-dispatch": "3.0.4"
  },
  "engines": {
    "node": ">=26.0.0 <27"
  }
}
