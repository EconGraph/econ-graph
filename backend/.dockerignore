# Build context for backend/Dockerfile. Only Cargo.toml, Cargo.lock (if present),
# crates/ and migrations/ are used.

# Rust build artifacts
target/
**/target/

# Stale, uncompiled copy of the crates -- never built into images
src/
backend/
migrations_backup/
scripts/
*.sql
test_census_api.rs

# NOTE: Cargo.lock is deliberately NOT ignored: it is gitignored, but when a local
# lockfile exists the image build should honour it.

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Documentation
README.md
*.md

# Logs
*.log

# Environment files
.env
.env.local
.env.*.local

# Temporary files
tmp/
temp/
**/*.rs.bk
