# Build context for backend/Dockerfile. Only Cargo.toml, Cargo.lock, crates/
# and migrations/ are used.

# Rust build artifacts
target/
**/target/

# Dev scripts and loose SQL dumps -- never built into images
scripts/
*.sql

# NOTE: Cargo.lock must NOT be ignored here: it is committed and the build
# uses `cargo build --locked`.

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Documentation
README.md
*.md

# Logs
*.log

# Environment files
.env
.env.local
.env.*.local

# Temporary files
tmp/
temp/
**/*.rs.bk
