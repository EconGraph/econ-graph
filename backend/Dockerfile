# syntax=docker/dockerfile:1.6
#
# Multi-stage Dockerfile for the EconGraph Rust workspace (build context: backend/).
#
# Targets:
#   (default, last stage)      econ-graph-backend   -> docker build -t econ-graph-backend .
#   --target crawler-worker    crawler-worker       -> docker build --target crawler-worker -t econ-graph-crawler-worker .
#
# Both images come from ONE cargo invocation in the `builder` stage, so building both
# targets compiles the workspace once.
#
# Only the workspace crates (crates/*), migrations/ and flags/ are copied in.
#
# Dependency caching uses BuildKit cache mounts (cargo registry, git checkouts and the
# target dir) instead of a dummy-main.rs skeleton, which never worked for this workspace
# (many crates, several [[bin]] paths). Requires BuildKit (default since Docker 23;
# docker/build-push-action always uses it).
#
# Cargo.lock: backend/Cargo.lock is committed and required. The build uses
# `--locked`, so a lockfile out of sync with Cargo.toml fails the build instead
# of silently re-resolving.

# Keep in sync with rust-toolchain.toml at the repository root (channel = "1.98.1").
# Bookworm to match the runtime image's glibc/OpenSSL/libpq.
ARG RUST_VERSION=1.98.1

############################
# Build stage
############################
FROM rust:${RUST_VERSION}-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config \
        libssl-dev \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
# Needed at compile time by embed_migrations!() in econ-graph-core.
COPY migrations ./migrations
# Build-time feature flags, generated by scripts/flags-merge (config/flags/README.md).
# Images always build the release profile; .cargo/config.toml (dev) is not copied in.
COPY flags ./flags
ENV FLAGS_PROFILE=release

# Extra cargo features, empty for release images. A development image can pass
# --build-arg CARGO_FEATURES=econ-graph-crawler-worker/static-catalogs.
ARG CARGO_FEATURES=""

# Build by binary name (not crate path): the crawler-worker binary may move between crates.
# --locked fails the build instead of silently re-resolving deps if Cargo.lock drifts from Cargo.toml.
# The target dir is a cache mount, so copy the binaries out within the same RUN.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/target \
    cargo build --release --locked --bin econ-graph-backend --bin crawler-worker --bin crawler \
        ${CARGO_FEATURES:+--features $CARGO_FEATURES} \
    && mkdir -p /out \
    && cp target/release/econ-graph-backend target/release/crawler-worker target/release/crawler /out/

############################
# Shared runtime base
############################
FROM debian:bookworm-slim AS runtime-base

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl3 \
        libpq5 \
    && rm -rf /var/lib/apt/lists/*

# UID/GID 1000 matches runAsUser/fsGroup in the k8s manifests.
RUN groupadd -g 1000 econuser && useradd -r -u 1000 -g econuser -s /bin/false econuser

WORKDIR /app

############################
# crawler-worker image (--target crawler-worker)
############################
FROM runtime-base AS crawler-worker

COPY --from=builder --chown=econuser:econuser /out/crawler-worker /app/crawler-worker
# The operator CLI (`kubectl exec deploy/crawler-worker -- /app/crawler coverage`); it reads the
# pod's DATABASE_URL and API keys.
COPY --from=builder --chown=econuser:econuser /out/crawler /app/crawler
# Reference data read at runtime (not compiled in), e.g. the U.S. states table.
COPY --chown=econuser:econuser crates/econ-graph-crawler/data /app/data
ENV CRAWLER_DATA_DIR=/app/data
# Shared reference data (econ-graph-core), e.g. the country table.
COPY --chown=econuser:econuser crates/econ-graph-core/data /app/reference
ENV REFERENCE_DATA_DIR=/app/reference

USER econuser

# Serves Prometheus /metrics and /healthz on 9102 (CRAWLER_METRICS_ADDR, default
# 0.0.0.0:9102); otherwise it only talks to Postgres and upstream APIs.
# It does not run migrations (the backend applies them at startup).
EXPOSE 9102
# SIGTERM: stops claiming new jobs and finishes in-flight ones.
STOPSIGNAL SIGTERM
ENV RUST_LOG=info
CMD ["/app/crawler-worker"]

############################
# Backend image (default target; keep this stage LAST)
############################
FROM runtime-base AS backend

# curl is only for the HEALTHCHECK below.
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder --chown=econuser:econuser /out/econ-graph-backend /app/econ-graph-backend
# Shared reference data (econ-graph-core) read at runtime (not compiled in), e.g. the country table.
COPY --chown=econuser:econuser crates/econ-graph-core/data /app/reference
ENV REFERENCE_DATA_DIR=/app/reference

USER econuser

# Default port; the application reads BACKEND_PORT at runtime.
EXPOSE 9876

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${BACKEND_PORT:-9876}/health || exit 1

CMD ["./econ-graph-backend"]
